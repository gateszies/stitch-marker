<%# locals: (icon:, size: :md) -%>

<%
    sizes = {
        sm: "size-icon-sm",
        md: "size-icon-md",
        lg: "size-icon-lg",
    }
%>

<svg aria-hidden="true" class="<%= sizes.fetch(size) %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <% case icon %>
    <% when :plus %>
      <path d="M12 5v14M5 12h14"/>
    <% when :check %>
      <path d="M5 12l5 5L20 7"/>
    <% when :arrow_right %>
      <path d="M5 12h14M13 6l6 6-6 6"/>
    <% when :arrow_left %>
      <path d="M19 12H5M11 6l-6 6 6 6"/>
    <% else %>
      <% raise ArgumentError, "Unknown icon: #{icon}" %>
    <% end %>
</svg>
